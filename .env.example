# 复制为 .env 并填入你的 key（.env 已被 .gitignore 忽略）
# 至少需要其一（取决于 --model 的 provider）：
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# 可选：DeepSeek 自定义端点（默认 https://api.deepseek.com）
# DEEPSEEK_BASE_URL=

# 网络搜索（research 默认开，可 --no-web 关；chat 默认关，可 --web 开）：
#   默认 provider = jina（免费，无需 key；JINA_API_KEY 可选，仅用于提升限速）
#   切换为 tavily：设 AS_WEB_PROVIDER=tavily 并填下面的 TAVILY_API_KEY
# AS_WEB_PROVIDER=jina
# JINA_API_KEY=
TAVILY_API_KEY=
